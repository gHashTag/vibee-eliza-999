{
  "name": "plugin-telegram-craft",
  "version": "1.0.0",
  "description": "ElizaOS plugin для Telegram userbot через MTProto (GramJS) с RAG и проактивным обучением",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "bun test",
    "test:component": "bun test src/__tests__/plugin-config.test.ts",
    "test:e2e": "elizaos test --type e2e",
    "postinstall": "node -e \"const fs=require('fs');const path=require('path');const zodPath=path.join('node_modules','zod');if(fs.existsSync(zodPath)){fs.writeFileSync(path.join(zodPath,'v3.js'),'module.exports=require(\\\"./lib/index.js\\\");');fs.writeFileSync(path.join(zodPath,'v3.d.ts'),'export * from \\\"./lib/index\\\");');}\" || true"
  },
  "keywords": [
    "elizaos",
    "plugin",
    "telegram",
    "mtproto",
    "gramjs",
    "userbot"
  ],
  "dependencies": {
    "@elizaos/core": "^1.6.4",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.8.3",
    "replicate": "^1.4.0",
    "telegram": "^2.26.22",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@elizaos/cli": "^1.6.4",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "@elizaos/core": "^1.6.0"
  },
  "files": [
    "src",
    "package.json"
  ],
  "author": "VIBEE Team",
  "license": "MIT"
}
