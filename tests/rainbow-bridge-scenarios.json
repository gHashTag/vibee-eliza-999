    {
      "name": "basic_start_command",
      "description": "Базовый тест команды /start",
      "critical": true,
      "tags": ["basic", "commands"],
      "steps": [
        {
          "action": "mcp_call",
          "tool": "telegram_send_message",
          "params": {
            "session_id": "sess_deubhyi0p828",
            "chat_id": "6579515876",
            "text": "/start"
          }
        },
        {
          "action": "wait",
          "timeout_ms": 3000
        },
        {
          "action": "mcp_call",
          "tool": "telegram_get_history",
          "params": {
            "session_id": "sess_deubhyi0p828",
            "chat_id": "6579515876",
            "limit": 5
          }
        },
        {
          "action": "assert",
          "field": "messages[0].text",
          "contains": ["ВАЙБИ", "привет", "Йоу", "бро"]
        }
      ]
    },
